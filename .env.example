# Copy to .env. NEVER commit real values.
APP_ENV=development            # development | staging | production
NETWORK=regtest                # regtest | signet | testnet | mainnet
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
WEB_URL=http://localhost:3000

DATABASE_URL=postgres://satlight:satlight@localhost:5432/satlight?sslmode=disable

# Lightning (LND)
LND_HOST=localhost:10009
LND_TLS_CERT=./dev/lnd/tls.cert
LND_INVOICE_MACAROON=./dev/lnd/invoice.macaroon   # receive-only
LND_PAYMENT_MACAROON=./dev/lnd/payment.macaroon   # send-only
PAYOUT_MAX_FEE_PPM=10000                          # 1%
PAYOUT_MAX_FEE_FLOOR_SATS=10

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./dev/github-app.pem
GITHUB_WEBHOOK_SECRET=
# GitHub App OAuth callback URL: http://localhost:8080/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Platform
PLATFORM_FEE_BPS=200           # 2%
BOUNTY_DEFAULT_EXPIRY_DAYS=90
CLAIM_EXPIRY_DAYS=7
PAYOUTS_PAUSED=false           # global kill switch
MIN_REWARD_SATS=500

# Sessions and secrets
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me

# Email
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=noreply@localhost

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
