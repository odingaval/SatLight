# Environment files - NEVER commit real secrets
.env
.env.local
.env.*.local

# Local development configs - contains macaroons, certs, private keys
dev/
!dev/.gitkeep

# Go build outputs
bin/
api
*.exe
*.test
*.prof

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
coverage.out
coverage.html

# Web frontend
web/node_modules/
web/node_modules.old/
web/dist/
web/.vite/
web/.eslintcache

# Docker
docker-compose.override.yml

# Generated files
*.pb.go
mock_*.go

# Temporary files
tmp/
temp/
*.tmp

# Local implementation notes
docs/guides/BACKEND_IMPLEMENTATION.md
.tmp-go-cache/
.tmp-go-build/

# Certificates and keys (if accidentally placed outside dev/)
*.pem
*.key
*.crt
*.cert
*.macaroon

# Database
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
